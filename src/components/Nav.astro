---
import ButtonBubble from './ButtonBubble.astro';
import { siteNav, serviceGroups, servicesNavBookCta, servicesNavAccordionLabel } from '../data/navigation';
---
<nav class="tsnav" data-twostep-nav data-nav-status="not-active" aria-label="Main">
  <div class="tsnav__bg" data-nav-toggle="close" aria-hidden="true"></div>
  <div class="tsnav__wrap">
    <div class="tsnav__width">
      <div class="tsnav__bar">
        <div class="tsnav__back" aria-hidden="true"><div class="tsnav__back-bg"></div></div>
        <div class="tsnav__top">
          <a class="tsnav__logo" href="/" aria-label="KlearNow home">
            <img class="tsnav__logo-img" src="/img/klearnow-logo-horizontal-primary.svg" alt="KlearNow" width="231" height="57" />
          </a>
          <button class="tsnav__toggle" type="button" data-nav-toggle="toggle" aria-expanded="false" aria-controls="nav-panel" aria-label="Open menu">
            <span class="tsnav__toggle-icon" aria-hidden="true">
              <i class="tsnav__toggle-bar"></i>
              <i class="tsnav__toggle-bar"></i>
            </span>
            <span class="tsnav__toggle-words" aria-hidden="true">
              <span class="tsnav__toggle-word tsnav__toggle-word--menu">Menu</span>
              <span class="tsnav__toggle-word tsnav__toggle-word--close">Close</span>
            </span>
          </button>
          <div class="tsnav__top-line" aria-hidden="true"></div>
        </div>
        <div class="tsnav__bottom" id="nav-panel">
          <div class="tsnav__bottom-overflow">
            <div class="tsnav__bottom-inner">
              <div class="tsnav__row">
                <div class="tsnav__col tsnav__col--info">
                  <p class="tsnav__eyebrow tsnav__eyebrow--site" aria-hidden="true"></p>
                  <ul class="tsnav__ul">
                    {siteNav.map((item) => (
                      <li><a class="tsnav__li" href={item.href}>{item.label}</a></li>
                    ))}
                  </ul>
                  <div class="tsnav__social">
                    <a href="https://www.linkedin.com/company/klearnow/" target="_blank" rel="noopener" aria-label="KlearNow on LinkedIn">
                      <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>
                    </a>
                  </div>
                </div>
                <div class="tsnav__col tsnav__col--services" data-acc-wrap>
                  <p class="tsnav__eyebrow tsnav__eyebrow--services" aria-hidden="true"></p>
                  <button type="button" class="tsnav__acc-head" aria-expanded="false" aria-controls="nav-services" data-acc-head>
                    <span>{servicesNavAccordionLabel}</span>
                    <span class="tsnav__acc-chip" aria-hidden="true"><i></i><i></i></span>
                  </button>
                  <div class="tsnav__acc" id="nav-services">
                    <div class="tsnav__acc-clip">
                      <div class="tsnav__services-row">
                        <div class="tsnav__groups">
                          {serviceGroups.map((group, index) => (
                            <>
                              <div class="tsnav__group">
                                <span class="tsnav__group-label">{group.label}</span>
                                <ul class="tsnav__group-list">
                                  {group.links.map((link) => (
                                    <li>
                                      <a class="tsnav__link" href={link.href}>
                                        <span class="tsnav__link-title">{link.title}</span>
                                        <span class="tsnav__link-blurb">{link.blurb}</span>
                                      </a>
                                    </li>
                                  ))}
                                </ul>
                              </div>
                              {index === serviceGroups.length - 1 ? (
                                <aside class="tsnav__book">
                                  <p class="tsnav__book-title">Let's talk about your next priorities.</p>
                                  <div class="tsnav__book-cta">
                                    <ButtonBubble href="/get-in-touch/" label={servicesNavBookCta} variant="blue" />
                                  </div>
                                </aside>
                              ) : null}
                            </>
                          ))}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="tsnav__mobile-cta">
                <ButtonBubble href="/get-in-touch/" label="Get in touch" variant="blue" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="tsnav__cta">
      <ButtonBubble href="/get-in-touch/" label="Request for Demo" variant="blue" />
    </div>
  </div>
</nav>
<script is:inline src="/scripts/nav.js"></script>
