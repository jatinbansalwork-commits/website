6ntz] li[data-astro-cid-hwvj6ntz]:before{content:\"\";background:var(--lime);border-radius:2px;width:10px;height:10px;position:absolute;top:.42em;left:0}.ctaband__actions[data-astro-cid-hwvj6ntz]{align-items:center;gap:var(--sp-3);flex-wrap:wrap;display:flex}.ctaband__quiet[data-astro-cid-hwvj6ntz]{font-size:var(--para-sm);opacity:.8;border-bottom:1px solid #fff6;padding-bottom:2px;transition:opacity .25s}.ctaband__quiet[data-astro-cid-hwvj6ntz]:hover,.ctaband__quiet[data-astro-cid-hwvj6ntz]:focus-visible{opacity:1}@media (width<=900px){.ctaband__inner[data-astro-cid-hwvj6ntz]{grid-template-columns:1fr}}@media (prefers-reduced-motion:reduce){.ctaband__quiet[data-astro-cid-hwvj6ntz]{transition:none}}\n.icon-chip[data-astro-cid-ccg5yoga]{width:var(--icon-chip-size,48px);height:var(--icon-chip-size,48px);background:var(--blue);color:var(--white);border-radius:var(--radius-sm);flex-shrink:0;place-items:center;display:grid}.icon-chip--on-dark[data-astro-cid-ccg5yoga]{background:#ffffff1a;border:1px solid #ffffff47}.icon-chip--bare[data-astro-cid-ccg5yoga]{color:inherit;background:0 0;border:0}.icon-chip--muted[data-astro-cid-ccg5yoga]{color:#201d1d8c;background:#201d1d0f;border:1px solid #201d1d1a}.icon-chip[data-astro-cid-ccg5yoga] svg[data-astro-cid-ccg5yoga]{width:58%;height:58%;display:block}.icon-chip--bare[data-astro-cid-ccg5yoga] svg[data-astro-cid-ccg5yoga]{width:100%;height:100%}"],"inlineModules":["document.querySelectorAll(`[data-faq]`).forEach(e=>{let t=e.querySelectorAll(`.faq__btn`);t.forEach(e=>{e.addEventListener(`click`,()=>{let n=e.getAttribute(`aria-expanded`)===`true`;t.forEach(e=>e.setAttribute(`aria-expanded`,`false`)),e.setAttribute(`aria-expanded`,String(!n)),window.setTimeout(()=>window.dispatchEvent(new Event(`resize`)),500)})})});"]}