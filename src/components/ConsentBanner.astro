<aside id="consent-banner" class="consent" hidden tabindex="-1" role="dialog" aria-modal="false" aria-labelledby="consent-title" aria-describedby="consent-body">
  <h2 id="consent-title" class="consent__title">Cookies</h2>
  <p id="consent-body" class="consent__body">
    Optional cookies help us measure visits and our LinkedIn ads.
    <a href="/cookies/">Cookie Policy</a>
  </p>
  <div class="consent__actions">
    <button type="button" class="consent__btn consent__btn--yes" data-consent-accept>Accept all</button>
    <button type="button" class="consent__btn consent__btn--no" data-consent-reject>Necessary only</button>
  </div>
</aside>
<script is:inline src="/scripts/consent.js"></script>
