;background:0 0;border:0}.icon-chip--muted[data-astro-cid-ccg5yoga]{color:#201d1d8c;background:#201d1d0f;border:1px solid #201d1d1a}.icon-chip[data-astro-cid-ccg5yoga] svg[data-astro-cid-ccg5yoga]{width:58%;height:58%;display:block}.icon-chip--bare[data-astro-cid-ccg5yoga] svg[data-astro-cid-ccg5yoga]{width:100%;height:100%}"],"inlineModules":["document.querySelectorAll(`[data-faq]`).forEach(e=>{let t=e.querySelectorAll(`.faq__btn`);t.forEach(e=>{e.addEventListener(`click`,()=>{let n=e.getAttribute(`aria-expanded`)===`true`;t.forEach(e=>e.setAttribute(`aria-expanded`,`false`)),e.setAttribute(`aria-expanded`,String(!n)),window.setTimeout(()=>window.dispatchEvent(new Event(`resize`)),500)})})});"]}